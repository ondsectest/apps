<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="calm_control.db" />
    </cloud-backup>
    <!--
      Device-to-device transfer keeps the log; it is the user's own history and losing it on a
      phone upgrade would cost them months of context.
    -->
    <device-transfer>
        <include domain="database" path="calm_control.db" />
    </device-transfer>
</data-extraction-rules>
