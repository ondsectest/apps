{
  "manifest_version": 3,
  "name": "Password Shoulder-Surf Shield",
  "version": "1.1.0",
  "description": "Hides your real password length from shoulder-surfers by randomizing dots as you type. Your real password still gets submitted.",
  "permissions": ["storage", "tabs", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-open-16.png",
    "32": "icons/icon-open-32.png",
    "48": "icons/icon-open-48.png",
    "128": "icons/icon-open-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Password Shoulder-Surf Shield",
    "default_icon": {
      "16": "icons/icon-open-16.png",
      "32": "icons/icon-open-32.png",
      "48": "icons/icon-open-48.png",
      "128": "icons/icon-open-128.png"
    }
  }
}
